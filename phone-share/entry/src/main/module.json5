{
  module: {
    name: "entry",
    type: "entry",
    description: "$string:share_description",
    mainElement: "ShareAbility",
    deviceTypes: ["phone", "tablet"],
    deliveryWithInstall: true,
    installationFree: false,
    pages: "$profile:main_pages",
    abilities: [{
      name: "ShareAbility",
      srcEntry: "./ets/entryability/ShareAbility.ets",
      launchType: "singleton",
      description: "$string:share_description",
      icon: "$media:app_icon",
      label: "$string:app_name",
      startWindowIcon: "$media:app_icon",
      startWindowBackground: "$color:start_window_background",
      exported: true,
      skills: [
        { actions: ["ohos.want.action.home"], entities: ["entity.system.home"] },
        {
          actions: ["ohos.want.action.sendData"],
          uris: [{ scheme: "file", utd: "general.image", maxFileSupported: 500 }]
        }
      ]
    }]
  }
}
